    {
      "id": "day-020-q1",
      "prompt": "認證與授權的差別是什麼？",
      "options": [
        "兩者完全相同",
        "認證確認身分，授權決定這個身分能做什麼",
        "授權一定在認證之前",
        "只有 Linux 需要授權"
      ],
      "correctOption": 1,
      "explanation": "登入是認證；之後每個操作是否允許，是授權。"
    },
    {
      "id": "day-020-q2",
      "prompt": "DAC 模型的主要特色是什麼？",
      "options": [
        "系統強制所有人遵守相同標籤",
        "資源擁有者可以決定誰能存取自己的資源",
        "權限只能由角色決定",
        "完全沒有權限概念"
      ],
      "correctOption": 1,
      "explanation": "DAC 由擁有者裁量，例如檔案 ACL。"
    },
    {
      "id": "day-020-q3",
      "prompt": "前端把管理按鈕藏起來，為什麼還不夠？",
      "options": [
        "因為按鈕可能跑到畫面外",
        "攻擊者可以直接呼叫後端 API，因此伺服器必須自行檢查權限",
        "因為藏起來會讓按鈕失效",
        "因為瀏覽器不支援隱藏"
      ],
      "correctOption": 1,
      "explanation": "UI 隱藏只是顯示層；真正安全必須在伺服器端逐請求驗證授權。"
    }
  ]
