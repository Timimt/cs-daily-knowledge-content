PORT=3001
DATABASE_PATH=./data/cs-daily.db

# GitHub content service. Keep the token server-side only.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_SYNC_ENABLED=false

# Single-user authentication. Generate values locally; never commit real values.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false

# Phase 2 only. Never expose these values through VITE_ variables.
# DEEPSEEK_API_KEY=
# DEEPSEEK_CHAT_MODEL=deepseek-flash
# DEEPSEEK_LESSON_MODEL=deepseek-v4-pro
