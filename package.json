{
  "name": "cs-daily-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm content:build",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --env-file-if-exists=.env scripts/dev-api.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "server:build": "node scripts/build-server.mjs",
    "pretypecheck": "pnpm content:build",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm content:build",
    "build": "pnpm typecheck && vite build && pnpm server:build",
    "build:pages": "node scripts/build-pages.mjs",
    "content:build": "node scripts/build-pages-content.mjs",
    "legacy:export-learning": "node scripts/export-legacy-learning.mjs",
    "start": "node --env-file-if-exists=.env scripts/start-server.mjs",
    "pretest": "pnpm content:build",
    "test": "vitest run",
    "test:github-content": "vitest run tests/unit/github-content.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "auth:hash": "node scripts/generate-password-hash.mjs",
    "auth:secret": "node scripts/generate-auth-secret.mjs",
    "auth:verify": "node --env-file-if-exists=.env scripts/auth-verify.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
